<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>visual_normal_force</name>
  <version>0.3.0</version>
  <description>Estima la fuerza normal (N) que la red ejerce sobre el ROV a partir de la imagen de la cámara (ConvNeXt-T en ONNX Runtime C++; TensorRT, CUDA o CPU).</description>
  <maintainer email="jorgee6404@gmail.com">CIRTESU</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>libopencv-dev</depend>
  <!-- ONNX Runtime (C/C++): no hay paquete apt ni clave rosdep; se busca en ONNXRUNTIME_ROOT (ver README) -->

  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
